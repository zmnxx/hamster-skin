// 定义共享前景偏移预设。
{
  // 26键（中文本体与功能键共用）。y 与英文那组保持同值，
  // 否则同一个键盘里字母角标和 123 键角标高度不一致。
  '上划文字偏移': {
    x: 0.5,
    y: 0.24,
  },
  '下划文字偏移': {
    x: 0.5,
    y: 0.76,
  },

  // 26键英文：上划角标在键帽上方、下划角标在下方，对齐参考图。
  // y 取 0.24 / 0.76 而不是更极端的 0.15 / 0.85 —— 后者角标贴到键帽描边上，
  // 观感像溢出边框。
  '英文上划文字偏移': {
    x: 0.5,
    y: 0.24,
  },
  '英文下划文字偏移': {
    x: 0.5,
    y: 0.76,
  },
  '英文上划sf符号偏移': {
    x: 0.5,
    y: 0.24,
  },
  '英文下划sf符号偏移': {
    x: 0.5,
    y: 0.76,
  },

  // 气泡
  '划动气泡文字偏移': {
    x: 0.5,
    y: 0.6,
  },
  '划动气泡sf符号偏移': {
    x: 0.5,
    y: 0.5,
  },

  '26键中文前景偏移': {
    x: 0.5,
    // 0.5 = 键帽正中。原本 0.54 是为「只有上方有角标」的旧布局留的下压量，
    // 现在上下都有角标，字母本体必须严格居中，否则读起来偏下。
    y: 0.5,
  },
  '功能键前景文字偏移': {  // 中英文在偏移上有些许不同
    x: 0.5,
    y: 0.5,  // 0.47
  },
  '中文九键字符前景偏移': {
    x: 0.5,
    y: 0.5,
  },
  '数字键盘数字前景偏移': {
    x: 0.5,
    y: 0.5,
  },

  // 数字键盘
  '数字键盘上划文字偏移': {
    x: 0.18,
    y: 0.28,
  },
  '数字键盘下划文字偏移': {
    x: 0.82,
    y: 0.28,
  },
  '数字键盘上划sf符号偏移': {
    x: 0.18,
    y: 0.28,
  },
  '数字键盘下划sf符号偏移': {
    x: 0.82,
    y: 0.28,
  },

  // toolbar部分偏移
  'toolbar按键文字偏移': {
    x: 0.5,
    // y: 0.8,
  },
  // panel浮动键盘
  'panel键盘按键文字前景偏移': {
    y: 0.7,
  },
  'panel键盘按键sf符号前景偏移': {
    y: 0.4,
  },
}
