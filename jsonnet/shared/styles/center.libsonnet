// 定义共享前景偏移预设。
{
  // 26键（中文本体与功能键共用）。与英文那组保持同值，
  // 否则同一个键盘里字母角标和 123 键角标高度不一致。
  //
  // 两个角标都在键帽上沿、左右分开：上划左上、下划右上。
  // 26 键键位只有约 34×38pt、字母本体 20pt 居中，所以角标不能取 x: 0.5
  // （正压在字母正上方），也不能贴到边（会压在键帽描边上、像溢出边框）。
  // y 取 0.23：比上沿 0.18 往里收，又仍在字母顶边（约 0.32）之上。
  // x 取 0.27 / 0.73：与字母左右缘（约 0.32 / 0.68）让开的同时，
  // 与键帽左右边各留约 0.2 的余量。
  '上划文字偏移': {
    x: 0.5,
    y: 0.18,
  },
  '下划文字偏移': {
    x: 0.5,
    y: 0.82,
  },

  // 26键英文：与中文 26 键同一套角标位置（上划左上、下划右上）。
  '英文上划文字偏移': {
    x: 0.5,
    y: 0.18,
  },
  '英文下划文字偏移': {
    x: 0.5,
    y: 0.82,
  },
  '英文上划sf符号偏移': {
    x: 0.5,
    y: 0.18,
  },
  '英文下划sf符号偏移': {
    x: 0.5,
    y: 0.82,
  },

  // 气泡
  '划动气泡文字偏移': {
    x: 0.5,
    y: 0.6,
  },
  '划动气泡sf符号偏移': {
    x: 0.5,
    y: 0.5,
  },

  '26键中文前景偏移': {
    x: 0.5,
    // 0.5 = 键帽正中。原本 0.54 是为「只有上方有角标」的旧布局留的下压量，
    // 现在上下都有角标，字母本体必须严格居中，否则读起来偏下。
    y: 0.5,
  },
  '功能键前景文字偏移': {  // 中英文在偏移上有些许不同
    x: 0.5,
    y: 0.5,  // 0.47
  },
  '中文九键字符前景偏移': {
    x: 0.5,
    y: 0.5,
  },
  '数字键盘数字前景偏移': {
    x: 0.5,
    y: 0.5,
  },

  // 数字键盘
  '数字键盘上划文字偏移': {
    x: 0.18,
    y: 0.28,
  },
  '数字键盘下划文字偏移': {
    x: 0.82,
    y: 0.28,
  },
  '数字键盘上划sf符号偏移': {
    x: 0.18,
    y: 0.28,
  },
  '数字键盘下划sf符号偏移': {
    x: 0.82,
    y: 0.28,
  },

  // toolbar部分偏移。与功能行前景（功能键前景文字偏移 y=0.5）对齐，
  // 让工具栏文字和下面一排功能键在竖直方向落在同一水平线上。
  'toolbar按键文字偏移': {
    x: 0.5,
    y: 0.5,
  },
  // 浮动面板按键：图标居于上部 40%、文字居于下部 72%，
  // 两者中心相距约 0.32 个键高，视觉上是「图标 + 标题」而非两行叠字。
  'panel键盘按键文字前景偏移': {
    y: 0.72,
  },
  'panel键盘按键sf符号前景偏移': {
    y: 0.4,
  },
}
