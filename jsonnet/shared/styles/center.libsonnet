// 定义共享前景偏移预设。
{
  // 26键（中文本体与功能键共用）。与英文那组保持同值，
  // 否则同一个键盘里字母角标和 123 键角标高度不一致。
  //
  // 角标统一落在键帽四角（上划右上 / 下划左下），不再居中：26 键键位只有
  // 约 34×38pt、字母本体 20pt 居中，角标若也取 x: 0.5 就正压在字母正上方 /
  // 正下方，读起来像"占用了字母的位置"。挪到角上并贴住上下边缘后，角标与
  // 居中的字母在横向、纵向都拉开距离。
  // y 不再更极端（0.1 以下）：那会让角标压到键帽描边上，像溢出边框。
  '上划文字偏移': {
    x: 0.78,
    y: 0.18,
  },
  '下划文字偏移': {
    x: 0.22,
    y: 0.82,
  },

  // 26键英文：与中文 26 键同一套角标位置（上划右上、下划左下）。
  '英文上划文字偏移': {
    x: 0.78,
    y: 0.18,
  },
  '英文下划文字偏移': {
    x: 0.22,
    y: 0.82,
  },
  '英文上划sf符号偏移': {
    x: 0.78,
    y: 0.18,
  },
  '英文下划sf符号偏移': {
    x: 0.22,
    y: 0.82,
  },

  // 气泡
  '划动气泡文字偏移': {
    x: 0.5,
    y: 0.6,
  },
  '划动气泡sf符号偏移': {
    x: 0.5,
    y: 0.5,
  },

  '26键中文前景偏移': {
    x: 0.5,
    // 0.5 = 键帽正中。原本 0.54 是为「只有上方有角标」的旧布局留的下压量，
    // 现在上下都有角标，字母本体必须严格居中，否则读起来偏下。
    y: 0.5,
  },
  '功能键前景文字偏移': {  // 中英文在偏移上有些许不同
    x: 0.5,
    y: 0.5,  // 0.47
  },
  '中文九键字符前景偏移': {
    x: 0.5,
    y: 0.5,
  },
  '数字键盘数字前景偏移': {
    x: 0.5,
    y: 0.5,
  },

  // 数字键盘
  '数字键盘上划文字偏移': {
    x: 0.18,
    y: 0.28,
  },
  '数字键盘下划文字偏移': {
    x: 0.82,
    y: 0.28,
  },
  '数字键盘上划sf符号偏移': {
    x: 0.18,
    y: 0.28,
  },
  '数字键盘下划sf符号偏移': {
    x: 0.82,
    y: 0.28,
  },

  // toolbar部分偏移。与功能行前景（功能键前景文字偏移 y=0.5）对齐，
  // 让工具栏文字和下面一排功能键在竖直方向落在同一水平线上。
  'toolbar按键文字偏移': {
    x: 0.5,
    y: 0.5,
  },
  // 浮动面板按键：图标居于上部 40%、文字居于下部 72%，
  // 两者中心相距约 0.32 个键高，视觉上是「图标 + 标题」而非两行叠字。
  'panel键盘按键文字前景偏移': {
    y: 0.72,
  },
  'panel键盘按键sf符号前景偏移': {
    y: 0.4,
  },
}
